{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psifunctiondev.github.io/methodos/schemas/task.schema.json",
  "title": "Méthodos Task",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "type", "title", "state", "parent_goal", "orchestrator", "priority", "objective", "success_criteria", "inherited_intent_context", "created", "modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^T-[0-9]{8}-[0-9]{3}$" },
    "type": { "const": "Task" },
    "title": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["Draft", "Ready", "Assigned", "Executing", "Waiting", "Blocked", "Ready for Review", "Accepted", "Cancelled", "Archived"]
    },
    "parent_goal": { "type": "string", "pattern": "^G-[0-9]{8}-[0-9]{3}$" },
    "orchestrator": { "type": "string", "minLength": 1 },
    "assigned_to": { "type": ["string", "null"] },
    "priority": { "type": "string", "enum": ["Low", "Normal", "High", "Critical"] },
    "objective": { "type": "string", "minLength": 1 },
    "success_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "inherited_intent_context": {
      "type": "object",
      "required": ["objective", "success_criteria", "constraints"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "success_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "string" },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "blocks": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "events": { "type": "array", "items": { "type": "string" } },
    "created": { "type": "string", "format": "date-time" },
    "modified": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
