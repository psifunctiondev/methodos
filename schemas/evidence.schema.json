{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psifunctiondev.github.io/methodos/schemas/evidence.schema.json",
  "title": "Méthodos Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "type", "title", "state", "creator", "claim", "supporting_artifacts", "validation_method", "confidence", "created", "modified", "related_objects"],
  "properties": {
    "id": { "type": "string", "pattern": "^E-[0-9]{8}-[0-9]{3}$" },
    "type": { "const": "Evidence" },
    "title": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["Draft", "Assembled", "Reviewed", "Accepted", "Superseded", "Archived"]
    },
    "creator": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date-time" },
    "modified": { "type": "string", "format": "date-time" },
    "claim": { "type": "string", "minLength": 1 },
    "supporting_artifacts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "validation_method": { "type": "string", "minLength": 1 },
    "confidence": { "type": "string", "enum": ["Low", "Moderate", "High", "Verified"] },
    "confidence_basis": { "type": "string" },
    "verification_method": { "type": ["string", "null"] },
    "verified_by": { "type": ["string", "null"] },
    "reviewer": { "type": ["string", "null"] },
    "related_objects": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "recommendation": {
      "type": "string",
      "enum": ["Accept", "Reject", "Additional Evidence Required", "Human Review Required", "Retry", "Escalate"]
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
